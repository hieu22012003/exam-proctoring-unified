{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "web",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://examwatch-api-zf06.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/:path*"
    }
  ]
}
